# The repository stores LF line endings, whatever editor is used on Windows.
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.woff2 binary

# Left out of the archives that GitHub and `git archive` build for releases
/tests export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore